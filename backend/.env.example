# Copy to .env. Never commit the copy. Format: Java properties (escape a backslash as \\).

# Required
DB_PASSWORD=
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Optional: creates this administrator at startup in the dev profile if the email isn't in use.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional: on an empty database, also creates 10 customers with this password and two months of
# order history. Without it, only the catalogue and the administrator are created.
SEED_CUSTOMER_PASSWORD=

# Optional overrides
# Use port 3307 for the private MySQL from local-db.sh.
# DB_URL=jdbc:mysql://127.0.0.1:3306/supplychain
# DB_TEST_URL=jdbc:mysql://127.0.0.1:3306/supplychain_test
# DB_USERNAME=supplychain
# SERVER_PORT=8081
